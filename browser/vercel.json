{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/capabilities",
      "destination": "/capabilities/medical",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/capabilities/medical",
      "permanent": true
    },
    {
      "source": "/solutions/it",
      "destination": "/capabilities/government-technology",
      "permanent": true
    },
    {
      "source": "/solutions/medical",
      "destination": "/capabilities/medical",
      "permanent": true
    },
    {
      "source": "/solutions/defence",
      "destination": "/capabilities/defence",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:page(about|contact|partners|who-we-serve|staffing-solutions|government-procurement)",
      "destination": "/index.html"
    },
    {
      "source": "/capabilities/:slug(medical|essential-supply|defence|government-technology)",
      "destination": "/index.html"
    },
    {
      "source": "/legal/:doc(privacy|terms|accessibility|supplier-code)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://zetsy.runasp.net https://script.google.com https://script.googleusercontent.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/:file([^/]+-[A-Z0-9]{8}\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:dir(images|videos|staffing)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "."
}